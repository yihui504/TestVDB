{
  "name": "testvdb",
  "displayName": "TestVDB - Vector Database Defect Miner",
  "version": "1.0.0",
  "description": "基于 LLM 的向量数据库自动化缺陷挖掘工具。支持 Milvus/Qdrant/Weaviate/PGVector 四种向量数据库，通过自然语言契约逆向工程从官方文档提取结构化约束，结合多 Agent 辩论机制在 Docker 沙箱中自动发现合规性缺陷。",
  "author": {
    "name": "TestVDB",
    "url": "https://github.com/yihui504/TestVDB"
  },
  "license": "MIT",
  "keywords": ["vector-database", "defect-mining", "milvus", "qdrant", "weaviate", "pgvector", "testing", "quality-assurance"],
  "commands": ["./commands/mine.md"],
  "agents": [
    "./agents/orchestrator.md",
    "./agents/knowledge-extractor.md",
    "./agents/contract-formalizer.md",
    "./agents/attack-boundary.md",
    "./agents/attack-state.md",
    "./agents/attack-semantic.md",
    "./agents/docker-executor.md",
    "./agents/judge-evidence.md",
    "./agents/judge-novelty.md",
    "./agents/judge-severity.md",
    "./agents/reporter.md"
  ],
  "mcpServers": "./.mcp.json"
}
