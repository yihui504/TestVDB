{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yihui504/TestVDB/settings_schema.json",
  "title": "TestVDB Settings Schema",
  "description": "Configuration schema for the TestVDB vector database defect mining plugin.",
  "type": "object",
  "required": ["docker", "retry", "results", "knowledge"],
  "properties": {
    "docker": {
      "type": "object",
      "required": ["cleanup_on_exit", "startup_timeout_seconds"],
      "properties": {
        "milvus": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 19530 },
            "health_port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 9091 }
          }
        },
        "qdrant": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 6333 },
            "grpc_port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 6334 }
          }
        },
        "weaviate": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 8080 },
            "grpc_port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 50051 }
          }
        },
        "pgvector": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 5432 }
          }
        },
        "meilisearch": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 7700 }
          }
        },
        "chroma": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 8000 }
          }
        },
        "cleanup_on_exit": { "type": "boolean", "default": true },
        "startup_timeout_seconds": { "type": "integer", "minimum": 10, "maximum": 600, "default": 120 }
      }
    },
    "retry": {
      "type": "object",
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 20, "default": 5 },
        "docker_startup_delay_seconds": { "type": "integer", "minimum": 1, "maximum": 60, "default": 10 },
        "script_execution_delay_seconds": { "type": "integer", "minimum": 1, "maximum": 30, "default": 3 },
        "doc_fetch_delay_seconds": { "type": "integer", "minimum": 1, "maximum": 30, "default": 5 },
        "llm_format_delay_seconds": { "type": "integer", "minimum": 0, "maximum": 30, "default": 0 }
      }
    },
    "results": {
      "type": "object",
      "properties": {
        "base_dir": { "type": "string", "default": "results" }
      }
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "cache_enabled": { "type": "boolean", "default": true },
        "cache_ttl_hours": { "type": "integer", "minimum": 1, "maximum": 8760, "default": 168 }
      }
    },
    "monitors": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true }
      }
    },
    "notification": {
      "type": "object",
      "properties": {
        "on_severity": { "type": "string", "enum": ["critical", "high", "medium", "low"], "default": "critical" },
        "webhook_url": { "type": "string", "format": "uri", "default": "" },
        "validate_on_start": { "type": "boolean", "default": true }
      }
    },
    "session": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string", "default": "" }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "proxy": { "type": "string", "default": "" }
      }
    },
    "log_level": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"],
      "default": "info"
    },
    "evolution": {
      "type": "object",
      "description": "v2.0 跨会话自进化配置",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "strategy_registry_dir": { "type": "string", "default": "strategy_registry" },
        "max_strategies_per_injection": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 },
        "min_confidence_for_injection": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.6 },
        "auto_deprecate_after_failures": { "type": "integer", "minimum": 1, "maximum": 20, "default": 3 }
      }
    },
    "ai_failure_check": {
      "type": "object",
      "description": "v2.0 AI 幻觉检测 7-Mode Checklist 配置",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "halt_on": { "type": "array", "items": { "type": "string" }, "default": ["M4", "M7"] },
        "reject_on": { "type": "array", "items": { "type": "string" }, "default": ["M2", "M3", "M6"] },
        "rewind_on": { "type": "array", "items": { "type": "string" }, "default": ["M1", "M5"] }
      }
    },
    "material_passport": {
      "type": "object",
      "description": "v2.0 契约完整性校验（sha256 防篡改）配置",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "hash_algorithm": { "type": "string", "enum": ["sha256"], "default": "sha256" },
        "reject_on_tamper": { "type": "boolean", "default": true }
      }
    },
    "intelligence": {
      "type": "object",
      "description": "v2.1 Phase 0 战略情报采集层配置。控制历史 Issue 挖掘、Bug Shape 提取和威胁模型构建。",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "cache_ttl_hours": { "type": "integer", "minimum": 0, "maximum": 8760, "default": 720 },
        "time_window_months": { "type": "integer", "minimum": 1, "maximum": 60, "default": 24 },
        "max_issues": { "type": "integer", "minimum": 10, "maximum": 2000, "default": 500 },
        "max_commits": { "type": "integer", "minimum": 10, "maximum": 1000, "default": 200 },
        "inject_to_attack_agents": { "type": "boolean", "default": true },
        "inject_to_judge_agents": { "type": "boolean", "default": true }
      }
    }
  }
}
