{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/hook_runner.py ${CLAUDE_PLUGIN_ROOT}/scripts/preflight.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/hook_runner.py ${CLAUDE_PLUGIN_ROOT}/scripts/log_execution.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/hook_runner.py ${CLAUDE_PLUGIN_ROOT}/scripts/write_location_check.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/hook_runner.py ${CLAUDE_PLUGIN_ROOT}/scripts/retry_policy.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/hook_runner.py ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pipeline_gate.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/hook_runner.py ${CLAUDE_PLUGIN_ROOT}/scripts/precompact_save.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python ${CLAUDE_PLUGIN_ROOT}/scripts/hook_runner.py ${CLAUDE_PLUGIN_ROOT}/scripts/postcompact_verify.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
