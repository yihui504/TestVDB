{
  "$schema": "./contracts/settings_schema.json",
  "_comment": "TestVDB 配置文件。所有路径相对于项目根目录。修改后无需重启。",
  "docker": {
    "milvus": {
      "port": 19530,
      "health_port": 9091
    },
    "qdrant": {
      "port": 6333,
      "grpc_port": 6334
    },
    "weaviate": {
      "port": 8080,
      "grpc_port": 50051
    },
    "pgvector": {
      "port": 5432
    },
    "cleanup_on_exit": true,
    "startup_timeout_seconds": 120
  },
  "retry": {
    "max_attempts": 5,
    "docker_startup_delay_seconds": 10,
    "script_execution_delay_seconds": 3,
    "doc_fetch_delay_seconds": 5,
    "llm_format_delay_seconds": 0,
    "_llm_format_delay_comment": "0 = no delay before retrying after LLM format error. Set >0 to add a pause (seconds) between format-error retries."
  },
  "pipeline": {
    "default_max_rounds": 5,
    "default_min_defects": 1
  },
  "results": {
    "base_dir": "results",
    "max_sessions": 10,
    "_max_sessions_comment": "Maximum concurrent mining sessions. Orchestrator checks active sessions before starting a new one. Exceeding this limit will cause the new session to be queued or rejected."
  },
  "knowledge": {
    "cache_enabled": true,
    "cache_ttl_hours": 168
  },
  "github": {
    "token": ""
  },
  "notification": {
    "on_severity": "critical",
    "webhook_url": "",
    "validate_on_start": true
  },
  "session": {
    "session_id": ""
  },
  "network": {
    "proxy": ""
  },
  "evolution": {
    "enabled": true,
    "strategy_registry_dir": "strategy_registry",
    "max_strategies_per_injection": 10,
    "min_confidence_for_injection": 0.6,
    "auto_deprecate_after_failures": 3
  },
  "fan_out": {
    "enabled": true,
    "seeds_per_agent": 3,
    "profiles": ["priority_first", "coverage_gap", "rejection_pattern"]
  },
  "ai_failure_check": {
    "enabled": true,
    "halt_on": ["M4", "M7"],
    "reject_on": ["M2", "M3", "M6"],
    "rewind_on": ["M1", "M5"]
  },
  "material_passport": {
    "enabled": true,
    "hash_algorithm": "sha256",
    "reject_on_tamper": true
  },
  "log_level": "info"
}
