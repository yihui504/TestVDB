{
  "docker": {
    "milvus": {
      "port": 19530,
      "health_port": 9091
    },
    "qdrant": {
      "port": 6333,
      "grpc_port": 6334
    },
    "weaviate": {
      "port": 8080,
      "grpc_port": 50051
    },
    "pgvector": {
      "port": 5432
    },
    "cleanup_on_exit": true,
    "startup_timeout_seconds": 120
  },
  "retry": {
    "max_attempts": 5,
    "docker_startup_delay_seconds": 10,
    "script_execution_delay_seconds": 3,
    "doc_fetch_delay_seconds": 5,
    "llm_format_delay_seconds": 0,
    "_llm_format_delay_comment": "0 = no delay before retrying after LLM format error. Set >0 to add a pause (seconds) between format-error retries."
  },
  "pipeline": {
    "default_max_rounds": 5,
    "default_min_defects": 1
  },
  "results": {
    "base_dir": "results",
    "max_sessions": 10,
    "_max_sessions_comment": "Maximum concurrent mining sessions. Orchestrator checks active sessions before starting a new one. Exceeding this limit will cause the new session to be queued or rejected."
  },
  "knowledge": {
    "cache_enabled": true,
    "cache_ttl_hours": 168
  },
  "monitors": {
    "enabled": true
  },
  "notification": {
    "on_severity": "critical",
    "webhook_url": "",
    "validate_on_start": true
  },
  "session": {
    "session_id": ""
  },
  "network": {
    "proxy": ""
  },
  "log_level": "info"
}
