{
  "api_endpoint": "create_collection+delete_collection+search_points+upsert_points+scroll_points+recommend_points",
  "doc_url": "https://qdrant.tech/documentation/concepts/search/",
  "assertions": [
    "[TYPE] collection_name must be string",
    "[TYPE] vectors.size must be integer (or uint)",
    "[RANGE] vectors.size must be > 0",
    "[TYPE] vectors.distance must be string (one of: \"Dot\", \"Cosine\", \"Euclid\", \"Manhattan\")",
    "[TYPE] vectors.datatype must be string (one of: \"float32\", \"uint8\")",
    "[TYPE] shard_number must be uint (unsigned integer) or null",
    "[RANGE] shard_number must be >= 1",
    "[TYPE] replication_factor must be uint (unsigned integer) or null",
    "[RANGE] replication_factor must be >= 1",
    "[TYPE] write_consistency_factor must be uint (unsigned integer) or null",
    "[RANGE] write_consistency_factor must be >= 1",
    "[TYPE] on_disk_payload must be boolean or null",
    "[TYPE] timeout must be integer (optional)",
    "[RANGE] timeout must be >= 0",
    "[TYPE] sharding_method must be string (one of: \"Auto\", \"Custom\")",
    "[TYPE] vectors must be object (single mode) or map of strings to objects (multiple mode)",
    "[TYPE] hnsw_config must be object or null",
    "[TYPE] wal_config must be object or null",
    "[TYPE] optimizers_config must be object or null",
    "[TYPE] quantization_config must be object or null",
    "[TYPE] sparse_vectors must be map from strings to objects or null",
    "[TYPE] strict_mode_config must be object or null",
    "[TYPE] metadata must be map from strings to any or null",
    "[TYPE] collection_name must be string",
    "[STATE:deterministic] collection must exist",
    "[TYPE] timeout must be integer",
    "[RANGE] timeout must be > 0",
    "[search_points] parameter validation for POST /collections/{collection_name}/points/search",
    "[TYPE] collection_name must be string",
    "[STATE:deterministic] collection must exist",
    "[TYPE] wait must be boolean",
    "[TYPE] ordering must be enum with allowed values weak, medium, strong",
    "[TYPE] timeout must be integer",
    "[RANGE] timeout must be >= 1",
    "[STATE:non-deterministic] point with existing id will be overwritten",
    "[TYPE] request body must be PointsBatch or PointsList",
    "[STATE:deterministic] request body is required",
    "[scroll_points] parameter validation for POST /collections/{collection_name}/points/scroll",
    "[recommend_points] parameter validation for POST /collections/{collection_name}/points/recommend"
  ],
